{
    "info": {
        "name": "Python CI/CD API Tests",
        "_postman_id": "python-ci-cd-api-tests",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
        {
            "name": "Health Check",
            "request": {
                "method": "GET",
                "header": [],
                "url": {
                    "raw": "http://localhost:5000/api/health",
                    "protocol": "http",
                    "host": [
                        "localhost"
                    ],
                    "port": "5000",
                    "path": [
                        "api",
                        "health"
                    ]
                }
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test('Status code is 200', function () {",
                            "    pm.response.to.have.status(200);",
                            "});",
                            "",
                            "pm.test('API status is UP', function () {",
                            "    pm.expect(pm.response.json().status).to.eql('UP');",
                            "});"
                        ]
                    }
                }
            ]
        },
        {
            "name": "Get Users",
            "request": {
                "method": "GET",
                "header": [],
                "url": {
                    "raw": "http://localhost:5000/api/users",
                    "protocol": "http",
                    "host": [
                        "localhost"
                    ],
                    "port": "5000",
                    "path": [
                        "api",
                        "users"
                    ]
                }
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test('Status code is 200', function () {",
                            "    pm.response.to.have.status(200);",
                            "});",
                            "",
                            "pm.test('Users list contains 2 users', function () {",
                            "    pm.expect(pm.response.json()).to.have.lengthOf(2);",
                            "});",
                            "",
                            "pm.test('First user has ID 1', function () {",
                            "    pm.expect(pm.response.json()[0].id).to.eql(1);",
                            "});"
                        ]
                    }
                }
            ]
        }
    ]
}